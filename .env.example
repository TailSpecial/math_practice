DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# Set all three values supplied by university IT to enable KubSU login.
KUBSU_OIDC_METADATA_URL=
KUBSU_CLIENT_ID=
KUBSU_CLIENT_SECRET=
KUBSU_LOGIN_CLAIM=preferred_username
# University registers http://127.0.0.1:8000/auth/kubsu/callback/ as a redirect URI.
# For HTTPS production:
# DEBUG=0
# SECURE_SSL_REDIRECT=1
# CSRF_TRUSTED_ORIGINS=https://practice.example.ru
